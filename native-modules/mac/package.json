{
  "name": "screen-capture-webrtc-native",
  "version": "1.0.0",
  "description": "Native macOS screen capture with WebRTC for Electron (Universal Binary)",
  "main": "index.js",
  "scripts": {
    "build": "./build-universal.sh",
    "build:universal": "./build-universal.sh",
    "build:intel": "./build-for-electron-direct.sh",
    "build:arm": "FORCE_ARCH=arm64 ./build-for-electron-direct.sh",
    "rebuild": "npm run build:universal",
    "test": "node examples/test_addon_only.js",
    "test:electron": "npx electron examples/electron-test-main.js",
    "verify": "lipo -info addon.node",
    "install": "npm run build:universal",
    "postinstall": "npm run verify"
  },
  "dependencies": {
    "node-addon-api": "^7.1.1"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-rebuild": "^3.2.9"
  },
  "files": [
    "src/",
    "scripts/",
    "examples/",
    "binding.gyp",
    "build-universal.sh",
    "build-for-electron-direct.sh",
    "index.js",
    "addon.node"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "binary": {
    "napi_versions": [
      8
    ]
  }
}
